# Optional override for the Web3Forms access key used by the Insights forms.
#
# You do NOT need to set this. The live key is committed in
# src/components/insights/useWeb3Form.ts, so the forms work from any build
# without environment configuration. Web3Forms keys are public by design:
# they identify the destination inbox and ship in the page source.
#
# Set this only to point a build at a different inbox — for example a preview
# deployment that should not email the live addresses. Add it in Vercel under
# Settings -> Environment Variables, or copy this file to .env.local locally.
#
# Note this overrides the primary recipient only. The additional recipient
# (howen@) is a second access key in COPY_TO_KEYS in the same file.
NEXT_PUBLIC_WEB3FORMS_KEY=
